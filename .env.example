# Backend Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Execution Engine Resource Limits
COMPILE_TIMEOUT_MS=5000
EXECUTION_TIMEOUT_MS=3000
MEMORY_LIMIT=128m
MEMORY_SWAP_LIMIT=128m
CPU_LIMIT=0.5
PIDS_LIMIT=64
MAX_OUTPUT_SIZE=65536
MAX_SOURCE_SIZE=102400
MAX_STDIN_SIZE=32768

# Docker Images
DOCKER_IMAGE_CPP=gcc:13.2.0-alpine
DOCKER_IMAGE_PYTHON=python:3.11-alpine
DOCKER_IMAGE_JAVA=eclipse-temurin:17-alpine
DOCKER_IMAGE_JAVASCRIPT=node:20-alpine
